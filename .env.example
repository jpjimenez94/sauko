# Asistente (obligatoria). Se crea en https://console.anthropic.com
ANTHROPIC_API_KEY=
# Solo si la clave no está asignada a un workspace (la API lo pide con un error 400).
# ANTHROPIC_WORKSPACE_ID=

# PIN del panel de la tienda (obligatorio en Vercel). Elija uno que solo conozca la tienda.
PANEL_PIN=

# Modelo del asistente. Por defecto claude-opus-5-5; claude-haiku-5-5 es mucho más barato.
# SAUKO_MODEL=claude-haiku-5-5

# Base de datos de pedidos: Redis de Upstash desde el Marketplace de Vercel.
# Vercel llena estas dos variables al conectar la base al proyecto.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Topes del chat (opcionales)
# CHAT_MAX_POR_HORA_IP=120
# CHAT_MAX_POR_DIA=4000

# WhatsApp Cloud API de Meta (para atender por WhatsApp)
# WHATSAPP_VERIFY_TOKEN: una palabra que usted inventa y repite al registrar el webhook en Meta.
# WHATSAPP_APP_SECRET: el App Secret de la app de Meta; con él se valida que los avisos vienen de Meta.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
