# Asistente (obligatoria). Se crea en https://console.anthropic.com
ANTHROPIC_API_KEY=
# Solo si la clave no está asignada a un workspace (la API lo pide con un error 400).
# ANTHROPIC_WORKSPACE_ID=

# PIN de instalación (obligatorio en Vercel): solo se pide una vez, para crear el primer administrador
# del panel. Después el panel se usa con usuario y contraseña, y los usuarios se crean desde el panel.
PANEL_PIN=

# Modelo del asistente. Por defecto claude-opus-5-5; claude-haiku-5-5 es mucho más barato.
# SAUKO_MODEL=claude-haiku-5-5

# OJO: el horario, las tarifas, la cuenta para transferir, la lista de prueba de WhatsApp y la pausa
# se cambian desde el panel (pestaña Ajustes, solo administradores). Las variables de abajo solo son
# el valor inicial mientras nadie guarde los Ajustes.
# Horario de domicilios (hora de Cali, en horas de 0 a 23) y tarifas. Estos son los valores por defecto:
# de 9 a 21 tarifa normal; de 21 a 22 horario prime; el resto queda como encargo para el día siguiente.
# Para no tener horario prime, DOMI_PRIME_HASTA se pone igual a DOMI_HASTA.
# DOMI_DESDE=9
# DOMI_HASTA=21
# DOMI_PRIME_HASTA=22
# COSTO_DOMICILIO=2000
# COSTO_DOMICILIO_PRIME=4000

# Notas de voz por WhatsApp: clave de Groq (console.groq.com) para transcribirlas.
# Sin ella, el asistente le pide al cliente que escriba.
GROQ_API_KEY=

# Datos para transferir, tal como el asistente se los dicta al cliente (banco, tipo y número de cuenta, llave, titular).
# Mientras esté vacío, el asistente dice que la tienda los comparte por el chat.
DATOS_TRANSFERENCIA=

# Historial de pedidos en Postgres (Neon desde Vercel, Railway u otro). Sin esto los pedidos quedan en Redis.
# DATABASE_URL=postgres://usuario:clave@servidor/base

# Redis de Upstash desde el Marketplace de Vercel: conversaciones de WhatsApp, agotados y ajustes.
# Vercel llena estas dos variables al conectar la base al proyecto.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Topes del chat (opcionales)
# CHAT_MAX_POR_HORA_IP=120
# CHAT_MAX_POR_DIA=4000

# WhatsApp por YCloud (el número sigue también en la app WhatsApp Business de la tienda)
# YCLOUD_FROM: el número de la tienda con indicativo, por ejemplo +573124529879.
# YCLOUD_WEBHOOK_SECRET: el secreto que YCloud muestra al crear el webhook. El webhook apunta a /api/ycloud.
YCLOUD_API_KEY=
YCLOUD_FROM=
YCLOUD_WEBHOOK_SECRET=
# Modo de prueba: si se llena, el asistente solo contesta a estos teléfonos (con indicativo, separados por coma).
# WHATSAPP_SOLO_NUMEROS=573001112233

# WhatsApp Cloud API de Meta directo (alternativa a YCloud; el webhook apunta a /api/whatsapp)
# WHATSAPP_VERIFY_TOKEN: una palabra que usted inventa y repite al registrar el webhook en Meta.
# WHATSAPP_APP_SECRET: el App Secret de la app de Meta; con él se valida que los avisos vienen de Meta.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
